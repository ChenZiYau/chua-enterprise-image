# Base URL of your existing property-management dashboard (no trailing slash).
# The Vault calls ${MAIN_APP_URL}/api/vault/properties to get the property list.
MAIN_APP_URL=https://your-dashboard.example.com

# Shared secret sent as `Authorization: Bearer ${VAULT_API_KEY}` to the main app.
# Generate the same value in the main app and keep it server-side only.
VAULT_API_KEY=change-me-to-a-long-random-string

# Vercel Blob read/write token. Created automatically when you add a Blob store
# to the project on Vercel; for local dev, copy it from the Vercel dashboard.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxx
